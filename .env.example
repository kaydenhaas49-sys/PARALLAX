# Base URL of your local OpenAI-compatible GLM server (omit /v1)
GLM_BASE_URL=http://127.0.0.1:8080
# Base URL of the local Qwen3-TTS V6 voice service
PARALLAX_TTS_BASE_URL=http://127.0.0.1:7861
# Qwen inference device; CPU keeps the GLM model's GPU memory free
PARALLAX_TTS_DEVICE=cpu
# Optional override for the V6 speaker-reference WAV
# PARALLAX_VOICE_REFERENCE=voice-auditions/parallax-qwen3-voice-design-v6.wav
