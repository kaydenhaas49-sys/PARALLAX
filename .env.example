# Base URL of your local OpenAI-compatible GLM server (omit /v1)
GLM_BASE_URL=http://127.0.0.1:8080
# Base URL of the local Qwen3-TTS V6 voice service
PARALLAX_TTS_BASE_URL=http://127.0.0.1:7861
# Qwen inference device; CPU keeps the local language model's GPU memory free
PARALLAX_TTS_DEVICE=cpu
# Optional override for the V6 speaker-reference WAV
# PARALLAX_VOICE_REFERENCE=voice-auditions/parallax-qwen3-voice-design-v6.wav

# Select the local inference engine: llamacpp (default) or ollama.
PARALLAX_ENGINE=llamacpp
# Ollama API base URL (Ollama runs at port 11434 by default).
PARALLAX_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional exact Ollama tag. Leave blank to auto-discover an installed model.
PARALLAX_OLLAMA_MODEL=

# OpenJarvis agent API (OpenJarvis itself talks to the selected local engine)
PARALLAX_JARVIS_BASE_URL=http://127.0.0.1:8123
